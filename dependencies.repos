# Exact revisions of independent Forge (SCPF) and Commands (SCPC) libraries.
# Both can be checked out reproducibly under ext/ using vcs2l.
# SCPF is pinned to the qualified main commit after Forge PR #300. It includes
# the v0.9.0 API plus the generic primitive/derived-body feature compiler fix
# and contract-matrix unit tests required by the Bolted Flange model.
repositories:
  scpf:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: 5b4963f25f76c4e3b09926d691251ed1b1e7173b
  scpc:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.cmd.git
    version: fcaa6f9fc8388bc715fcd2fbb149ce6b979566a7
