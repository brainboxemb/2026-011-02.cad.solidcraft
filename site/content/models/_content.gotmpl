{{/*
Generic model page adapter.

- model.yml owns presentation metadata, including section/group taxonomy and
  optional physical-owner variant grouping;
- site/data/cad/catalog.yml owns taxonomy labels/order;
- ci.yml owns build/source identity;
- prepared-build/main is mounted read-only so Pages can inspect the accepted
  build-plan and command JSON during rendering;
- generated CAD artifacts remain owned by the build branch and are never copied
  into gh-pages;
- model_history.json owns derived Git last-modified presentation data;
- physical owners with multiple build variants get one owner page while every
  existing variant detail URL remains valid.
*/}}

{{ $planResource := resources.Get "build/build-plan.json" }}
{{ if not $planResource }}
  {{ errorf "missing durable build/main/build-plan.json" }}
{{ end }}
{{ $plan := $planResource | transform.Unmarshal }}
{{ $rows := index $plan "models" }}
{{ if not $rows }}
  {{ errorf "durable build plan contains no model rows" }}
{{ end }}

{{ $history := hugo.Data.cad.model_history }}
{{ if not $history }}
  {{ errorf "missing generated data/cad/model_history.json" }}
{{ end }}
{{ $historyRoots := index $history "roots" }}

{{ $catalog := hugo.Data.cad.catalog }}
{{ if not $catalog }}
  {{ errorf "missing site data/cad/catalog.yml" }}
{{ end }}
{{ $sectionDefs := index $catalog "sections" }}
{{ $groupDefs := index $catalog "groups" }}

{{ range $sectionDef := $sectionDefs }}
  {{ $section := index $sectionDef "id" }}
  {{ $.AddPage (dict
    "kind" "page"
    "path" $section
    "title" (index $sectionDef "page_title")
    "params" (dict "categoryIndex" true "cadSection" $section)
  ) }}
{{ end }}

{{ range $modelResource := resources.Match "cad-source/**/model.yml" }}
  {{ $modelRootPath := strings.TrimPrefix "/" (path.Dir $modelResource.Name) }}
  {{ $modelRoot := strings.TrimPrefix "cad-source/" $modelRootPath }}
  {{ $rootMeta := $modelResource | transform.Unmarshal }}
  {{ $ciResource := resources.Get (printf "cad-source/%s/ci.yml" $modelRoot) }}
  {{ if not $ciResource }}
    {{ errorf "%s: missing ci.yml" $modelRoot }}
  {{ end }}
  {{ $ci := $ciResource | transform.Unmarshal }}

  {{ $process := true }}
  {{ if isset $ci "process" }}
    {{ $process = index $ci "process" }}
  {{ end }}
  {{ if not $process }}
    {{ continue }}
  {{ end }}

  {{ $section := index $rootMeta "section" }}
  {{ $sectionMatches := where $sectionDefs "id" $section }}
  {{ if ne (len $sectionMatches) 1 }}
    {{ errorf "%s: unknown catalog section %q" $modelRoot $section }}
  {{ end }}

  {{ $group := index $rootMeta "group" }}
  {{ with $group }}
    {{ $groupMatches := where $groupDefs "id" . }}
    {{ if ne (len $groupMatches) 1 }}
      {{ errorf "%s: unknown catalog group %q" $modelRoot . }}
    {{ end }}
  {{ end }}

  {{ $lastmodRaw := index $historyRoots $modelRoot }}
  {{ if not $lastmodRaw }}
    {{ errorf "missing model history for %s" $modelRoot }}
  {{ end }}
  {{ $lastmod := time.AsTime $lastmodRaw }}
  {{ $priority := default 1000 (index $rootMeta "priority") }}

  {{ $entries := slice }}
  {{ with $variants := index $ci "variants" }}
    {{ $metaVariants := index $rootMeta "variants" }}
    {{ range $variant := $variants }}
      {{ $slug := index $variant "id" }}
      {{ $meta := $rootMeta }}
      {{ with $metaVariants }}
        {{ $meta = index . $slug }}
        {{ if not $meta }}
          {{ errorf "%s: model.yml has no metadata for build variant %s" $modelRoot $slug }}
        {{ end }}
      {{ end }}
      {{ $entries = $entries | append (dict
        "slug" $slug
        "source" (index $variant "source")
        "model" $meta
      ) }}
    {{ end }}
  {{ else }}
    {{ $entries = $entries | append (dict
      "slug" (index $ci "id")
      "source" (index $ci "source")
      "model" $rootMeta
    ) }}
  {{ end }}

  {{ $variantIds := slice }}
  {{ range $entry := $entries }}
    {{ $variantIds = $variantIds | append (index $entry "slug") }}
  {{ end }}

  {{ $hasOwnerPage := gt (len $entries) 1 }}
  {{ $ownerPath := "" }}
  {{ $ownerTitle := "" }}

  {{ if $hasOwnerPage }}
    {{ $ownerPath = printf "owners/%s" $modelRoot }}
    {{ $firstEntry := index $entries 0 }}
    {{ $firstModel := index $firstEntry "model" }}
    {{ $firstSlug := index $firstEntry "slug" }}
    {{ $firstMatches := where $rows "id" $firstSlug }}
    {{ if ne (len $firstMatches) 1 }}
      {{ errorf "%s: expected exactly one durable build row, found %d" $firstSlug (len $firstMatches) }}
    {{ end }}
    {{ $ownerBuild := index $firstMatches 0 }}
    {{ $ownerTitle = default (index $firstModel "title") (index $rootMeta "title") }}
    {{ $ownerTagline := default (index $firstModel "tagline") (index $rootMeta "tagline") }}
    {{ $ownerDescription := default (index $firstModel "description") (index $rootMeta "description") }}
    {{ $variantGroups := default (slice) (index $rootMeta "variant_groups") }}

    {{ $groupSeen := slice }}
    {{ range $variantGroup := $variantGroups }}
      {{ $variantGroupTitle := index $variantGroup "title" }}
      {{ $groupVariants := index $variantGroup "variants" }}
      {{ if not $variantGroupTitle }}
        {{ errorf "%s: variant group is missing title" $modelRoot }}
      {{ end }}
      {{ if not $groupVariants }}
        {{ errorf "%s: variant group %s has no variants" $modelRoot $variantGroupTitle }}
      {{ end }}
      {{ range $groupVariant := $groupVariants }}
        {{ if not (in $variantIds $groupVariant) }}
          {{ errorf "%s: variant group %s references unknown variant %s" $modelRoot $variantGroupTitle $groupVariant }}
        {{ end }}
        {{ if in $groupSeen $groupVariant }}
          {{ errorf "%s: variant %s appears in more than one variant group" $modelRoot $groupVariant }}
        {{ end }}
        {{ $groupSeen = $groupSeen | append $groupVariant }}
      {{ end }}
    {{ end }}

    {{ $ownerModel := dict
      "title" $ownerTitle
      "tagline" $ownerTagline
      "description" $ownerDescription
      "parameters" (printf "%d variants" (len $entries))
      "priority" $priority
    }}

    {{ $.AddPage (dict
      "content" (dict
        "mediaType" "text/markdown"
        "value" $ownerDescription
      )
      "dates" (dict "lastmod" $lastmod)
      "kind" "page"
      "path" $ownerPath
      "title" $ownerTitle
      "params" (dict
        "model" $ownerModel
        "build" $ownerBuild
        "cadOwnerIndex" true
        "catalogEntry" true
        "cadSection" $section
        "cadGroup" $group
        "cadRoot" $modelRoot
        "cadPriority" $priority
        "ownerVariantIds" $variantIds
        "variantGroups" $variantGroups
      )
    ) }}

    {{ with resources.Get (printf "cad-source/%s/page.md" $modelRoot) }}
      {{ $.AddResource (dict
        "content" (dict "mediaType" "text/markdown" "value" .Content)
        "path" (printf "%s/page.md" $ownerPath)
      ) }}
    {{ end }}
  {{ end }}

  {{ range $entry := $entries }}
    {{ $slug := index $entry "slug" }}
    {{ $sourcePath := index $entry "source" }}
    {{ $model := index $entry "model" }}
    {{ $matches := where $rows "id" $slug }}
    {{ if ne (len $matches) 1 }}
      {{ errorf "%s: expected exactly one durable build row, found %d" $slug (len $matches) }}
    {{ end }}
    {{ $build := index $matches 0 }}

    {{ $.AddPage (dict
      "content" (dict
        "mediaType" "text/markdown"
        "value" (index $model "description")
      )
      "dates" (dict "lastmod" $lastmod)
      "kind" "page"
      "path" $slug
      "title" (index $model "title")
      "params" (dict
        "model" $model
        "cadSection" $section
        "cadGroup" $group
        "cadRoot" $modelRoot
        "cadSlug" $slug
        "cadVariant" true
        "cadPriority" $priority
        "catalogEntry" (not $hasOwnerPage)
        "cadOwnerPath" $ownerPath
        "cadOwnerTitle" $ownerTitle
        "sourcePath" $sourcePath
        "build" $build
        "toolchain" (dict
          "forge" (index $plan "forge")
          "solidcraft" (index $plan "solidcraft")
        )
      )
    ) }}

    {{ range $resource := slice
      (dict "source" (printf "cad-source/%s/model.yml" $modelRoot) "target" "model.yml" "media" "text/plain")
      (dict "source" (printf "cad-source/%s/ci.yml" $modelRoot) "target" "ci.yml" "media" "text/plain")
      (dict "source" (printf "cad-source/%s/%s" $modelRoot $sourcePath) "target" "scpf-source.py" "media" "text/plain")
    }}
      {{ with resources.Get (index $resource "source") }}
        {{ $.AddResource (dict
          "content" (dict "mediaType" (index $resource "media") "value" .Content)
          "path" (printf "%s/%s" $slug (index $resource "target"))
        ) }}
      {{ end }}
    {{ end }}

    {{ with resources.Get (printf "cad-source/%s/page.md" $modelRoot) }}
      {{ $.AddResource (dict
        "content" (dict "mediaType" "text/markdown" "value" .Content)
        "path" (printf "%s/page.md" $slug)
      ) }}
    {{ end }}

    {{ with $views := index $model "extra_views" }}
      {{ range $view := index $views "items" }}
        {{ if eq (index $view "kind") "asset" }}
          {{ $name := index $view "src" }}
          {{ with resources.Get (printf "cad-source/%s/%s" $modelRoot $name) }}
            {{ $.AddResource (dict
              "content" (dict "mediaType" .MediaType.Type "value" .Content)
              "path" (printf "%s/%s" $slug $name)
            ) }}
          {{ end }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
