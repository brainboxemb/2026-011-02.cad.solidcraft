# Exact revisions of independent Forge (SCPF) and Commands (SCPC) libraries.
# Both can be checked out reproducibly under ext/ using vcs2l.
# SCPF is pinned to the exact v0.8.1 release commit. This release includes
# selective Sketch profile extrusion, the shared fillet/chamfer edge-selection
# API and the reusable-component replay-binding fix used by the current CAD
# models.
repositories:
  scpf:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: 377a2a1f5420fa7f0ca45fd8ad2cb6fd576b1072
  scpc:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.cmd.git
    version: fcaa6f9fc8388bc715fcd2fbb149ce6b979566a7
