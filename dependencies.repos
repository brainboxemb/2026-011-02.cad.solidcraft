# Exact revisions used by the CAD repository.
# SCPF and SCPC are installed as Python libraries by bootstrap.ps1 and are
# baked into the immutable CAD toolchain image.
# tool.cad.ci is checked out as executable repository tooling under ext/cad-ci.
# The workflow also installs that exact checkout on the host for generated
# build/Page publication; the immutable CAD image remains independent of it.
repositories:
  scpf:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: 5b4963f25f76c4e3b09926d691251ed1b1e7173b
  scpc:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.cmd.git
    version: fcaa6f9fc8388bc715fcd2fbb149ce6b979566a7
  cad-ci:
    type: git
    url: https://github.com/brainboxemb/tool.cad.ci.git
    version: 556e8d43dde9218b28a8d991ab9f2021232e76ab
