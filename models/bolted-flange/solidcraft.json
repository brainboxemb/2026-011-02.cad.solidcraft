{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "pcd",
        "expression": "70",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "bolts",
        "expression": "6",
        "unit": ""
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "XY",
        "name": "Disc"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0,
          0
        ],
        "diameter": 100
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": 10,
        "direction": "positive",
        "body_name": "Flange"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "Flange"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "Flange",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Hub"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0.0,
          0.0
        ],
        "diameter": 44
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "join",
        "targets": [
          "Flange"
        ],
        "name": "Hub",
        "distance": 16,
        "direction": "positive"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "origin": [
            0.0,
            0.0,
            0.0
          ],
          "x_dir": [
            1,
            0,
            0
          ],
          "y_dir": [
            0,
            1,
            0
          ]
        },
        "name": "Bore"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0.0,
          0.0
        ],
        "diameter": 24
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "Flange"
        ],
        "name": "Bore",
        "distance": 26,
        "direction": "positive"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "origin": [
            0.0,
            0.0,
            0.0
          ],
          "x_dir": [
            1,
            0,
            0
          ],
          "y_dir": [
            0,
            1,
            0
          ]
        },
        "name": "BoltHole"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          "(pcd / 2)",
          0.0
        ],
        "diameter": 9
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "Flange"
        ],
        "name": "BoltHole",
        "distance": 10,
        "direction": "positive"
      }
    },
    {
      "command": "solid.pattern.circular",
      "params": {
        "features": [
          "BoltHole"
        ],
        "axis": "Z",
        "count": "bolts",
        "alignment": "right",
        "reversed": false
      }
    }
  ]
}
