{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "width",
        "expression": "80",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "depth",
        "expression": "50",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "thickness",
        "expression": "8",
        "unit": "mm"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "XY",
        "name": "Base"
      }
    },
    {
      "command": "sketch.rectangle.two_point",
      "params": {
        "p0": [
          "-(width / 2)",
          "-(depth / 2)"
        ],
        "p1": [
          "width / 2",
          "depth / 2"
        ]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": "thickness",
        "direction": "positive",
        "body_name": "SamplePlate"
      }
    },
    {
      "command": "solid.fillet",
      "params": {
        "edges": [
          [
            -40.0,
            -25.0,
            4.0
          ],
          [
            40.0,
            -25.0,
            4.0
          ],
          [
            40.0,
            25.0,
            4.0
          ],
          [
            -40.0,
            25.0,
            4.0
          ]
        ],
        "radius": 6,
        "body": "SamplePlate"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "SamplePlate"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "SamplePlate",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Holes"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          "(-((width - 24 mm) / 2))",
          0.0
        ],
        "diameter": 8
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "SamplePlate"
        ],
        "name": "Holes",
        "through_all": true,
        "direction": "negative"
      }
    },
    {
      "command": "solid.pattern.rectangular",
      "params": {
        "features": [
          "Holes"
        ],
        "dir1": [
          1.0,
          0.0,
          0.0
        ],
        "count1": 2,
        "spacing1": "width - 24 mm",
        "alignment": "right",
        "reversed": false
      }
    },
    {
      "command": "solid.cylinder",
      "params": {
        "height": 14,
        "diameter": 24,
        "base": [
          0.0,
          0.0,
          8.0
        ],
        "axis": "Z",
        "operation": "join",
        "targets": [
          "SamplePlate"
        ],
        "references": [
          {
            "edge": [
              -40.0,
              0.0,
              8.0
            ],
            "distance": "(width / 2)"
          },
          {
            "edge": [
              0.0,
              -25.0,
              8.0
            ],
            "distance": "(depth / 2)"
          }
        ]
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "XY",
        "name": "Bore",
        "offset": "thickness + 14 mm"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0.0,
          0.0
        ],
        "diameter": 12
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": "thickness + 14 mm",
        "direction": "negative",
        "operation": "cut",
        "targets": [
          "SamplePlate"
        ],
        "name": "Bore"
      }
    }
  ]
}
