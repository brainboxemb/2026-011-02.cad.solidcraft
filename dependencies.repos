# Exact revisions of independent Forge (SCPF) and Commands (SCPC) libraries.
# Both can be checked out reproducibly under ext/ using vcs2l.
# SCPF is temporarily pinned to the qualified post-0.7.0 development commit
# that adds selective explicit-Sketch profile extrusion (issue #282) and the
# shared fillet/chamfer edge-selection API (issue #280). Keep the exact commit
# until these changes are included in the next normal SCPF release.
repositories:
  scpf:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: 1ca462b4aff1495b00644571b89216579a4dd9c3
  scpc:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.cmd.git
    version: fcaa6f9fc8388bc715fcd2fbb149ce6b979566a7
