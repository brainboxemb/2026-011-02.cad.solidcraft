    {
      "command": "parameters.add",
      "params": {
        "name": "rear_hole_relief",
        "expression": "0.3",
        "unit": "mm"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "XZ",
        "name": "Sharp hook side profile"
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "points": [
          [
            0.0,
            -0.0
          ],
          [
            "rib",
            -0.0
          ],
          [
            "(rib + (opening_width)) + (rib)",
            "-(((overall_height - (opening_depth)) + (short_tip_rise)) - (short_outer_height))"
          ],
          [
            "(rib + (opening_width)) + (rib)",
            "-((overall_height - (opening_depth)) + (short_tip_rise))"
          ],
          [
            "rib + (opening_width)",
            "-((overall_height - (opening_depth)) + (short_tip_rise))"
          ],
          [
            "rib + (opening_width)",
            "-(overall_height - (opening_depth))"
          ],
          [
            "rib",
            "-(overall_height - (opening_depth))"
          ],
          [
            "rib",
            "-(overall_height)"
          ],
          [
            0.0,
            "-(overall_height)"
          ]
        ],
        "closed": true,
        "ids": [
          "back_lower",
          "diagonal_lower",
          "diagonal_upper",
          "outer_tip_upper",
          "inner_tip_upper",
          "inner_tip_lower",
          "inner_back_corner",
          "back_upper_inner",
          "back_upper_outer"
        ]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": "thickness",
        "direction": "symmetric",
        "body_name": "WallHook"
      }
    },
    {
      "command": "solid.fillet",
      "params": {
        "edges": [
          [
            0.0,
            0.0,
            0.0
          ],
          [
            6.0,
            0.0,
            0.0
          ],
          [
            32.0,
            0.0,
            26.0
          ],
          [
            32.0,
            0.0,
            42.0
          ],
          [
            26.0,
            0.0,
            42.0
          ],
          [
            26.0,
            0.0,
            32.0
          ],
          [
            6.0,
            0.0,
            32.0
          ],
          [
            6.0,
            0.0,
            57.0
          ],
          [
            0.0,
            0.0,
            57.0
          ]
        ],
        "radius": "profile_fillet",
        "body": "WallHook"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "XZ",
        "name": "Sharp triangular gusset window"
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "points": [
          [
            "rib",
            "-(rib * 1.41421)"
          ],
          [
            "((overall_height - (opening_depth)) - (rib)) - ((rib * 1.41421) - (rib))",
            "-((overall_height - (opening_depth)) - (rib))"
          ],
          [
            "rib",
            "-((overall_height - (opening_depth)) - (rib))"
          ]
        ],
        "closed": true,
        "ids": [
          "window_lower",
          "window_front",
          "window_upper"
        ]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": "thickness",
        "direction": "symmetric",
        "operation": "cut",
        "targets": [
          "WallHook"
        ]
      }
    },
    {
      "command": "solid.fillet",
      "params": {
        "edges": [
          [
            6.0,
            0.0,
            8.485281374238571
          ],
          [
            23.51471862576143,
            0.0,
            26.0
          ],
          [
            6.0,
            0.0,
            26.0
          ]
        ],
        "radius": "window_fillet",
        "body": "WallHook"
      }
    },
    {
      "command": "solid.cylinder",
      "params": {
        "height": "((rib + (opening_width)) + (rib)) - (rib)",
        "diameter": "tool_access_diameter",
        "base": [
          "rib",
          0,
          "lower_hole_from_bottom"
        ],
        "axis": "X",
        "operation": "cut",
        "targets": [
          "WallHook"
        ]
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "WallHook"
      },
      "bind": {
        "$topology_face_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              -1,
              0
            ]
          },
          "max": "area"
        }
      }
    },
    {
      "command": "model.edges",
      "params": {
        "body": "WallHook"
      },
      "bind": {
        "$topology_edges_1": {
          "field": "edges",
          "boundary_of": "$topology_face_1",
          "body": "WallHook"
        }
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "WallHook"
      },
      "bind": {
        "$topology_face_2": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              1,
              0
            ]
          },
          "max": "area"
        }
      }
    },
    {
      "command": "model.edges",
      "params": {
        "body": "WallHook"
      },
      "bind": {
        "$topology_edges_2": {
          "field": "edges",
          "boundary_of": "$topology_face_2",
          "body": "WallHook",
          "prepend": "$topology_edges_1"
        }
      }
    },
    {
      "command": "solid.chamfer",
      "params": {
        "edges": "$topology_edges_2",
        "distance": "face_chamfer",
        "body": "WallHook"
      }
    },
    {
      "command": "solid.hole",
      "params": {
        "position": [
          "rib",
          0.0,
          "overall_height - (upper_hole_from_top)"
        ],
        "targets": [
          "WallHook"
        ],
        "diameter": "hole_diameter",
        "depth": "rib",
        "direction": [
          -1.0,
          0.0,
          0.0
        ],
        "type": "countersink",
        "cs_diameter": "hole_diameter + (front_hole_chamfer * 2)",
        "cs_angle": 90
      }
    },
    {
      "command": "solid.hole",
      "params": {
        "position": [
          0.0,
          0.0,
          "overall_height - (upper_hole_from_top)"
        ],
        "targets": [
          "WallHook"
        ],
        "diameter": "hole_diameter",
        "depth": "rib",
        "direction": [
          1.0,
          0.0,
          0.0
        ],
        "type": "countersink",
        "cs_diameter": "hole_diameter + (rear_hole_relief * 2)",
        "cs_angle": 90
      }
    },
    {
      "command": "solid.hole",
      "params": {
        "position": [
          "rib",
          0.0,
          "lower_hole_from_bottom"
        ],
        "targets": [
          "WallHook"
        ],
        "diameter": "hole_diameter",
        "depth": "rib",
        "direction": [
          -1.0,
          0.0,
          0.0
        ],
        "type": "countersink",
        "cs_diameter": "hole_diameter + (front_hole_chamfer * 2)",
        "cs_angle": 90
      }
    },
    {
      "command": "solid.hole",
      "params": {
        "position": [
          0.0,
          0.0,
          "lower_hole_from_bottom"
        ],
        "targets": [
          "WallHook"
        ],
        "diameter": "hole_diameter",
        "depth": "rib",
        "direction": [
          1.0,
          0.0,
          0.0
        ],
        "type": "countersink",
        "cs_diameter": "hole_diameter + (rear_hole_relief * 2)",
        "cs_angle": 90
      }
    },
    {
      "command": "appearance.assign",
      "params": {
        "bodies": [
          "WallHook"
        ],
        "color": "#FFD21A"
      }
    }
  ]
}
